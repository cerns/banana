{
  "name": "@isbael/bananab-server",
  "version": "1.0.0",
  "description": "Session orchestration server with SSH remote execution",
  "main": "dist/index.js",
  "bin": {
    "banana-server": "dist/index.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/http/dashboard && cp -r src/http/dashboard dist/http/dashboard",
    "dev": "node dist/index.js",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "ssh2": "^1.16.0",
    "web-push": "^3.6.7",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.10"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
