# Shared secret — must match between server, client, and CLI
BANANA_TOKEN=your-secret-token

# Server configuration
BANANA_PORT=3000
BANANA_HISTORY_MAX=1000
BANANA_PERSIST_PATH=     # optional: /path/to/sessions.json

# Client configuration
BANANA_SERVER_URL=ws://localhost:3000
BANANA_WORKDIR=          # defaults to process.cwd()
BANANA_CLAUDE_BIN=claude # or full path to claude binary
